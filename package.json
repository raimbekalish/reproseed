{
  "name": "reproseed",
  "version": "0.1.0",
  "private": true,
  "description": "Reproduce difficult bugs, minimize failing scenarios, and generate reliable regression tests.",
  "type": "module",
  "bin": {
    "reproseed": "./dist/cli.js"
  },
  "files": [
    "dist",
    "examples/duplicate-submit/scenario.json",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raimbekalish/reproseed.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/copy-export-assets.mjs",
    "cli": "node dist/cli.js",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "test:demo": "node --test examples/duplicate-submit/*.test.ts",
    "test:runner": "node --test test/runner/*.test.ts",
    "test:export": "node --test test/export/regression.test.ts",
    "test:cli": "node --test test/cli/args.test.ts test/cli/scenario.test.ts test/cli/command.test.ts",
    "test:cli:e2e": "node --test test/cli/e2e.test.ts",
    "demo": "node examples/duplicate-submit/server.ts"
  },
  "dependencies": {
    "playwright": "^1.64.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  }
}
